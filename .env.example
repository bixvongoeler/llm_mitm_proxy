# =============================================================================
# LLM MITM Proxy - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# These credentials are required for the LLM chat functionality.
# The proxy will still work for HTTPS interception without them.
# =============================================================================

# LLMProxy API credentials (required for chat functionality)
# Get these from your Tufts LLMProxy account
LLMPROXY_API_KEY=your-api-key-here
LLMPROXY_ENDPOINT=https://your-llmproxy-endpoint.com/prod

# =============================================================================
# Optional: Override default ports (not typically needed)
# =============================================================================
# PROXY_PORT=9999
# CHAT_PORT=5001
